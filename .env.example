# Copy to .env and set values for this Docker host.
# DNS, Kea DDNS, the BIND metrics scrape, and BIND Grafana dashboard are optional.
# Set COMPOSE_PROFILES=dns to enable them. Configure client-facing resolver
# addresses in Kea's DHCP configuration files.
COMPOSE_PROFILES=

# Published ports bind to all host interfaces by default. Set a specific host
# interface address for any service that should bind more narrowly.
DHCP4_BIND_ADDRESS=0.0.0.0
DHCP6_BIND_ADDRESS=::
DHCP4_CTRL_BIND_ADDRESS=0.0.0.0
DHCP6_CTRL_BIND_ADDRESS=0.0.0.0
DDNS_CTRL_BIND_ADDRESS=0.0.0.0
BIND9_BIND_ADDRESS=0.0.0.0
# Host port 53 may conflict with DNS services already using it. If unavailable, set this to 5353 or 1053.
BIND9_BIND_PORT=53
STORK_BIND_ADDRESS=0.0.0.0
PROMETHEUS_BIND_ADDRESS=0.0.0.0
GRAFANA_BIND_ADDRESS=0.0.0.0

# Kea DHCP4, DHCP6, and DDNS Control API credentials.
DHCP4_API_USER=kea-dhcp4-api
DHCP4_API_PASS=replace-with-a-long-random-value
DHCP6_API_USER=kea-dhcp6-api
DHCP6_API_PASS=replace-with-a-long-random-value
DDNS_API_USER=kea-ddns-api
DDNS_API_PASS=replace-with-a-long-random-value
# Required when DNS is enabled. Replace this public example with your own
# TSIG HMAC-SHA256 secret: base64-encoded 32 random bytes.
DDNS_TSIG_KEY="IV9IaFqx+/uZi6CfHvTRudMRM22lVrO3QjAjsYrOkhw="

# Lease PostgreSQL account and database for DHCP leases.
LEASE_DB_USER=kea_lease
LEASE_DB_PASS=replace-with-a-long-random-value
LEASE_DB_NAME=kea_leases

# Shared PostgreSQL account and database for reservations and legal logs.
SHARED_DB_USER=kea
SHARED_DB_PASS=replace-with-a-long-random-value
SHARED_DB_NAME=kea_db

# Kea lease and shared reservations/logging database backup schedule.
SHARED_DB_BACKUP_INTERVAL_SECONDS=10800
SHARED_DB_BACKUP_RETENTION_DAYS=1

# Stork PostgreSQL account (the separate stork-db service).
STORK_DB_USER=stork
STORK_DB_PASS=replace-with-a-long-random-value

# Stork database backup schedule.
STORK_DB_BACKUP_INTERVAL_SECONDS=86400
STORK_DB_BACKUP_RETENTION_DAYS=3

# Grafana web UI administrator credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=replace-with-a-long-random-value

# Stork UI initial built-in login: admin / admin.
# Sign in and change the password in Stork after first start.
